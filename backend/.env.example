# Quant Vector backend configuration — example placeholders.
# Copy to .env and fill in real values. NEVER commit the real .env.

# --- Developer PIN (dataset administration) --------------------------------
# scrypt hash of the developer PIN in the format:
#   scrypt$n$r$p$salt_hex$hash_hex
# Generate one with:
#   python -c "import auth; print(auth.hash_password('YOUR-PIN'))"
MARKETDNA_DEV_PIN_HASH=
# Alias accepted on hosting platforms: DEVELOPER_PIN_HASH

# --- Session signing -------------------------------------------------------
# Random secret used to sign session cookies (e.g. `secrets.token_hex(32)`).
# Rotating it signs everyone out. Alias accepted: SESSION_SECRET
MARKETDNA_SESSION_SECRET=

# Session lifetime in seconds (default 43200 = 12 hours).
MARKETDNA_SESSION_MAX_AGE=43200

# Cookie hardening. For cross-site deployments (frontend on Vercel, API on a
# different domain) set SAMESITE=none AND SECURE=true (HTTPS required).
MARKETDNA_COOKIE_SAMESITE=lax
MARKETDNA_COOKIE_SECURE=false

# --- Login rate limiting ---------------------------------------------------
MARKETDNA_LOGIN_MAX_ATTEMPTS=5
MARKETDNA_LOGIN_WINDOW_SECONDS=60

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
MARKETDNA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# The deployed UI origin(s); merged into the allow-list automatically.
FRONTEND_URL=

# --- MySQL (read by database.py) -------------------------------------------
# Precedence: MYSQL_* -> DB_* -> Railway's MYSQLHOST-style names -> defaults.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=market_dna
#
# Hosted example (Railway):
#   MYSQL_HOST=<proxy host>      (or DB_HOST)
#   MYSQL_PORT=<proxy port>      (or DB_PORT)
#   MYSQL_USER=<user>            (or DB_USER)
#   MYSQL_PASSWORD=<password>    (or DB_PASSWORD)
#   MYSQL_DATABASE=<database>    (or DB_NAME)

# --- AI layer (VECTOR intelligence, optional) ------------------------------
# Provider-agnostic OpenAI-compatible configuration.
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
# Per-provider key aliases also accepted when AI_API_KEY is unset:
#   GROQ_API_KEY / OPENAI_API_KEY / GEMINI_API_KEY
