# Quant Vector frontend configuration (Vite).
# Copy to .env for local overrides. NEVER commit real .env files.

# Base URL of the Quant Vector API.
#
# - Local development: leave UNSET. The Vite dev server proxies /api/* to
#   http://127.0.0.1:8000 (see vite.config.js), which keeps the session
#   cookie first-party.
# - Production (Vercel): set this to the public backend URL, e.g.
#     VITE_API_BASE_URL=https://your-backend.up.railway.app
VITE_API_BASE_URL=
